<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#087f36">
<title>NAIJA ARENA | NAIJA TASK</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{--green:#087f36;--dark:#064d25;--light:#0b9b45;--lime:#b7ef43;--bg:#f3f8f5;--text:#173326;--muted:#708176;--line:#e0eae3;--red:#c62828}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:var(--bg);color:var(--text);font:14px/1.5 Arial,Helvetica,sans-serif;padding-bottom:30px}
a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer}
.top{background:var(--dark);color:#fff;padding:14px 16px;display:flex;justify-content:space-between;align-items:center}
.top b{font-size:17px}.top a{font-size:13px;font-weight:700;color:var(--lime)}
.wrap{max-width:640px;margin:auto;padding:16px}
.card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:16px;margin-bottom:14px;box-shadow:0 5px 18px rgba(6,77,37,.07)}
h1{margin:0 0 6px;font-size:22px}h2{margin:0 0 10px;font-size:17px}
p{margin:0 0 10px;color:var(--muted)}
.btn{display:block;width:100%;border:0;border-radius:12px;padding:14px;font-weight:800;font-size:14px;background:var(--green);color:#fff;margin-top:10px}
.btn.alt{background:#e8f4eb;color:var(--dark)}.btn:disabled{opacity:.55}
.opt{display:block;width:100%;text-align:left;border:2px solid var(--line);background:#fff;border-radius:12px;padding:13px;margin-top:9px;font-weight:700;color:var(--text)}
.opt.sel{border-color:var(--green);background:#eaf7ee}
.opt.good{border-color:#17a34a;background:#e1f5e7}.opt.bad{border-color:var(--red);background:#fff0f0}
.bar{height:6px;background:#e7efe8;border-radius:6px;overflow:hidden;margin-bottom:12px}.bar i{display:block;height:100%;background:var(--light);width:0}
.msg{display:none;padding:12px;border-radius:12px;margin-bottom:12px;font-size:13px}
.msg.show{display:block}.msg.err{background:#fff0f0;color:#a21d1d}.msg.ok{background:#e5f7ea;color:#17682e}
.row{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}
.row:last-child{border:0}.score{font-size:42px;font-weight:900;color:var(--green);margin:6px 0}
.small{font-size:12px;color:var(--muted)}.hide{display:none}
select{width:100%;padding:12px;border:1px solid var(--line);border-radius:12px;font:inherit;background:#fff}
</style>
</head>
<body>
<div class="top"><b>🎮 NAIJA ARENA</b><a href="dashboard.html">← Dashboard</a></div>
<div class="wrap">
  <div id="msg" class="msg" role="status"></div>

<style id="nt-game-ad-styles">
.nt-game-ad{margin:14px 0;padding:12px;border:1px solid #dce9df;border-radius:15px;background:#f4faf5;text-align:center;overflow:hidden}
.nt-ad-label{display:block;margin-bottom:8px;color:#54715d;font-size:10px;font-weight:900;letter-spacing:1px}
.nt-banner-slot{width:100%;min-height:50px;display:flex;justify-content:center;align-items:center;overflow:hidden}
.nt-game-ad p{font-size:12px;color:#617267;margin:0 0 10px}
.nt-offer-link,.nt-load-ad{display:block;width:100%;max-width:280px;margin:8px auto;padding:11px 12px;border:0;border-radius:11px;background:#b7ef43;color:#064d25;text-decoration:none;font-size:13px;font-weight:900}
.nt-load-ad{background:#087f36;color:#fff}
.nt-load-ad:disabled{opacity:.65}
.nt-game-ad small{display:block;color:#708176;font-size:10px;line-height:1.5}
</style>
  <div id="home" class="hide">

    <section class="nt-game-ad" aria-label="Advertisement">
      <span class="nt-ad-label">ADVERTISEMENT</span>
      <div class="nt-banner-slot">
        <script>
          atOptions = { 'key':'dc095c7f78341b7c3f8c3cd337d72815', 'format':'iframe', 'height':50, 'width':320, 'params':{} };
        </script>
        <script src="https://bicea.org/22/dc095c7f78341b7c3f8c3cd337d72815"></script>
      </div>
    </section>
    <section class="nt-game-ad nt-sponsored" aria-label="Sponsored offer">
      <span class="nt-ad-label">SPONSORED OFFER</span>
      <p>Optional sponsored content. Open only if you want to visit the advertiser.</p>
      <a class="nt-offer-link" href="https://arwf.org/4/7de42ae45e004227aa64a037c9fea378" target="_blank" rel="noopener noreferrer">Visit sponsored offer ↗</a>
      <button class="nt-load-ad" id="ntQuizLoad" type="button">Load sponsored advert</button>
      <small id="ntQuizStatus">The external script remains off until you tap the button.</small>
      <div id="ntQuizHost"></div>
    </section>
    <div class="card">
      <h1>Brain Battle</h1>
      <p>Answer Nigerian knowledge questions and earn game points. Game points are for fun and the leaderboard. They are not naira and cannot be withdrawn.</p>
      <label class="small" for="cat">Category</label>
      <select id="cat"><option value="">All categories</option></select>
      <label class="small" for="cnt" style="margin-top:10px;display:block">Questions per game</label>
      <select id="cnt"><option value="10">10 questions</option><option value="15">15 questions</option><option value="20">20 questions</option></select>
      <button id="startBtn" class="btn" type="button">Start game</button>
      <p class="small" style="margin-top:10px">Play as many games as you like. 10 points for each correct answer. The weekly board counts your best 20 games.</p>
    </div>
    <div class="card">
      <h2>🏆 This week's leaderboard</h2>
      <div id="board"><p>Loading...</p></div>
    </div>
  </div>

  <div id="quiz" class="hide">
    <div class="card">
      <div class="small" id="qcount"></div>
      <div class="bar"><i id="qbar"></i></div>
      <h2 id="qtext"></h2>
      <div id="qopts"></div>
      <button id="nextBtn" class="btn" type="button" disabled>Next</button>
    </div>
  </div>

  <div id="result" class="hide">
    <div class="card" style="text-align:center">
      <p>Your score</p>
      <div class="score" id="rScore">0</div>
      <p id="rTotal"></p>
      <button id="nextGameBtn" class="btn" type="button">Play another game</button>
      <button id="againBtn" class="btn alt" type="button">Back to Arena</button>
    </div>
    <div class="card"><h2>Review</h2><div id="review"></div></div>
  </div>
</div>

<script>
"use strict";
const db = window.supabase.createClient("https://jwakveeiynpakunwjzkj.supabase.co", "sb_publishable_iT-y7ZOr_7g_SOx6ZPzR2A_ZjjnLZ6D");
const $ = id => document.getElementById(id);
const esc = v => String(v ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"})[c]);

let session = null, answers = [], idx = 0, picked = -1, busy = false;

function show(id){ ["home","quiz","result"].forEach(x => $(x).classList.toggle("hide", x !== id)); window.scrollTo(0,0); }
function say(text, kind){ const m = $("msg"); m.textContent = text; m.className = "msg show " + (kind || "err"); }
function clear(){ $("msg").className = "msg"; $("msg").textContent = ""; }

async function init(){
  try{
    const { data: u } = await db.auth.getUser();
    if (!u?.user){ location.replace("login.html"); return; }

    const { data: flag, error } = await db.from("platform_feature_flags").select("enabled").eq("key","arena").maybeSingle();
    if (error || !flag || flag.enabled !== true){ say("NAIJA ARENA is not open yet. Please check back soon."); return; }

    show("home");
    loadCategories();
    loadBoard();
  }catch(e){ console.error(e); say("Could not open Arena. Check your internet and refresh."); }
}

async function loadCategories(){
  const { data, error } = await db.rpc("arena_categories");
  if (error){ console.warn(error.message); return; }
  const sel = $("cat");
  (data || []).forEach(r => { const o = document.createElement("option"); o.value = r.category; o.textContent = r.category + (r.questions > 0 ? " (" + r.questions + ")" : " (endless)"); sel.appendChild(o); });
}

async function loadBoard(){
  const box = $("board");
  const { data, error } = await db.rpc("arena_leaderboard", { p_days: 7 });
  if (error){ box.innerHTML = "<p>Leaderboard unavailable right now.</p>"; return; }
  if (!data || !data.length){ box.innerHTML = "<p>No scores yet. Be the first!</p>"; return; }
  box.innerHTML = data.map(r => `<div class="row"><span>#${esc(r.rank)} ${esc(r.display_name)}</span><b>${esc(r.points)} pts</b></div>`).join("");
}

$("startBtn").addEventListener("click", async () => {
  if (busy) return; busy = true; clear();
  const btn = $("startBtn"); btn.disabled = true; btn.textContent = "Starting...";
  try{
    const { data, error } = await db.rpc("arena_start_session", { p_category: $("cat").value || null, p_count: Number($("cnt").value) || 10 });
    if (error) throw error;
    session = data; answers = []; idx = 0; picked = -1;
    show("quiz"); renderQuestion();
  }catch(e){ say(e.message || "Could not start the game."); }
  finally{ busy = false; btn.disabled = false; btn.textContent = "Start game"; }
});

function renderQuestion(){
  const qs = session.questions, q = qs[idx];
  picked = -1;
  $("qcount").textContent = "Question " + (idx + 1) + " of " + qs.length;
  $("qbar").style.width = (idx / qs.length * 100) + "%";
  $("qtext").textContent = q.question;
  $("qopts").innerHTML = q.options.map((o, i) => `<button class="opt" type="button" data-i="${i}">${esc(o)}</button>`).join("");
  $("qopts").querySelectorAll(".opt").forEach(b => b.addEventListener("click", () => {
    picked = Number(b.dataset.i);
    $("qopts").querySelectorAll(".opt").forEach(x => x.classList.toggle("sel", x === b));
    $("nextBtn").disabled = false;
  }));
  $("nextBtn").disabled = true;
  $("nextBtn").textContent = idx === qs.length - 1 ? "Finish" : "Next";
}

$("nextBtn").addEventListener("click", async () => {
  if (picked < 0 || busy) return;
  answers.push(picked);
  if (idx < session.questions.length - 1){ idx++; renderQuestion(); return; }
  busy = true; $("nextBtn").disabled = true; $("nextBtn").textContent = "Scoring...";
  try{
    const { data, error } = await db.rpc("arena_submit_session", { p_session_id: session.session_id, p_answers: answers });
    if (error) throw error;
    showResult(data);
  }catch(e){ say(e.message || "Could not submit your answers."); $("nextBtn").disabled = false; $("nextBtn").textContent = "Finish"; }
  finally{ busy = false; }
});

function showResult(r){
  $("rScore").textContent = r.score;
  $("rTotal").textContent = "out of " + r.total_points + " points";
  $("review").innerHTML = (r.results || []).map((x, n) => `
    <div style="margin-bottom:14px">
      <b>${n + 1}. ${esc(x.question)}</b>
      ${(x.options || []).map((o, i) => `<div class="opt ${i === x.correct_index ? "good" : (i === x.your_answer ? "bad" : "")}" style="cursor:default">${esc(o)}${i === x.correct_index ? " ✓" : ""}</div>`).join("")}
      ${x.explanation ? `<p class="small" style="margin-top:6px">${esc(x.explanation)}</p>` : ""}
    </div>`).join("");
  show("result");
}

$("nextGameBtn").addEventListener("click", () => { clear(); show("home"); $("startBtn").click(); });
$("againBtn").addEventListener("click", () => { clear(); show("home"); loadBoard(); });

init();
</script>
<script>
(function(){
 const b=document.getElementById('ntQuizLoad'),h=document.getElementById('ntQuizHost'),s=document.getElementById('ntQuizStatus');
 if(!b||!h||!s)return;let loaded=false;
 b.addEventListener('click',function(){
  if(loaded)return;loaded=true;b.disabled=true;b.textContent='Loading sponsored advert…';
  const t=document.createElement('script');t.async=true;t.dataset.cfasync='false';t.src='https://afders.org/1/5f6722d503776e9a4c128d973279063e';
  t.onload=function(){b.textContent='Sponsored advert requested';s.textContent='External advert script loaded. Advert content is controlled by the provider.'};
  t.onerror=function(){loaded=false;b.disabled=false;b.textContent='Try loading sponsored advert again';s.textContent='Could not load the external advert. Try again later.';t.remove()};
  h.appendChild(t);
 });
})();
</script>
</body>
</html>
